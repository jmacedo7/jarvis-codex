{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python -c \"import os,runpy; runpy.run_path(os.path.join(os.environ['JARVIS_ROOT'],'hooks','trava.py'),run_name='__main__')\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
