# Configuração do JARVIS conectado ao Codex.

# Pasta que o Codex deve usar como área de trabalho.
JARVIS_PASTA=~/Documentos/meu-vault
JARVIS_PORTA=8790

# Codex CLI: instale e autentique com "codex" antes de iniciar o JARVIS.
JARVIS_CODEX_BIN=codex
# Vazio usa o modelo padrão da sua conta Codex.
JARVIS_MODELO=
# Esforço de raciocínio: low | medium | high | xhigh (conforme o modelo).
JARVIS_ESFORCO=low

# Aprovações nativas: onRequest | unlessTrusted.
JARVIS_APROVACAO=onRequest
# Rede do sandbox desativada por padrão. Use 1 apenas se realmente precisar.
JARVIS_REDE=0

# leve = limita leituras iniciais; completo = consulta instruções e documentação relevantes.
JARVIS_CONTEXTO=leve
JARVIS_PERSONA=persona.md

# ElevenLabs é opcional: sem chave, o JARVIS responde em texto na tela.
ELEVENLABS_API_KEY=
JARVIS_VOZ=xHUwLsLfyqiYOIVTzLRW
# eleven_multilingual_v2 = melhor som | eleven_flash_v2_5 = menor latência.
JARVIS_MODELO_VOZ=eleven_multilingual_v2
# Velocidade da fala: 1.0 normal (de 0.7 a 1.2).
JARVIS_VELOCIDADE_VOZ=1.0

# Transcrição: auto (Whisper local e fallback para ElevenLabs) | whisper | elevenlabs.
JARVIS_TRANSCRICAO=auto
WHISPER_URL=http://127.0.0.1:8178

# Atalhos lentos aquecidos na inicialização (separe por ;).
# Exemplo: isca_resumo.py --dia ontem
JARVIS_AQUECER_ATALHOS=
